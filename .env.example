# Environment variables for Manga Translator

# Application & Server
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:8000
DATABASE_URL=postgresql://manga_user:manga_password@localhost:5432/manga_db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Gemini AI (Multimodal OCR, Translation & Pipeline)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Translation Provider Options: gemini (default), mock, custom
TRANSLATION_PROVIDER=gemini
TRANSLATION_API_KEY=

# OCR Provider Options: gemini (default), tesseract, mock
OCR_PROVIDER=gemini
OCR_API_KEY=

# Storage Provider Options: local (default), s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=manga-translated-pages
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Limits & Safeguards
MAX_PAGES_PER_JOB=50
MAX_IMAGE_SIZE_MB=20
MAX_SOURCE_HTML_MB=10
JOB_TIMEOUT_MINUTES=15
REQUEST_TIMEOUT_SECONDS=15
